<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The OS selects the starting window before Compose reads the saved appearance. -->
    <style name="BcmPlatformTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FAF5EF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.BookCoverMatcher" parent="BcmPlatformTheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
