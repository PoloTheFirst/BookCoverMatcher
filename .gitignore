# Native OCR library: a build output, produced by tools/build-native-ocr.ps1 and packaged through
# Gradle's jniLibs mechanism. Never committed.
app/src/main/jniLibs/*/libbc_ocr.so

# PP-OCRv6 Medium model weights: fetched, SHA-256-verified and packaged by the Gradle task
# `preparePaddleOcrAssets` (app/build.gradle.kts). ~139 MB of binaries do not belong in git.
app/src/main/assets/ocr/
tools/ocr-reference/out/
app/src/main/assets/licenses/
