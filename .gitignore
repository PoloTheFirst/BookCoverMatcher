# Gradle / Android Studio
.gradle/
build/
local.properties
.idea/
*.iml
captures/
.cxx/

# The OpenCLIP model is large: generate it with tools/export_openclip_onnx.py
*.onnx
*.onnx.json
*.onnx.sha256

# Python tooling
__pycache__/
*.pyc
.venv/
sample_catalog.xlsx
sample_covers/

# Android build outputs
app/release/
*.apk

# Native OCR library: a build output, produced by tools/build-native-ocr.ps1 and packaged through
# Gradle's jniLibs mechanism. Never committed.
app/src/main/jniLibs/*/libbc_ocr.so

# PP-OCRv6 Medium model weights: fetched, SHA-256-verified and packaged by the Gradle task
# `preparePaddleOcrAssets` (app/build.gradle.kts). ~139 MB of binaries do not belong in git.
app/src/main/assets/ocr/
tools/ocr-reference/out/
app/src/main/assets/licenses/

# The personal catalogue workbook stays on the owner's machine; it is not distributed.
test_excel/doujin.xlsx

# Machine-local Azure app-registration values for the OneDrive sign-in (v2.6.0).
# Copy `.env.example` to `.env` in the repository root and fill in the three values. The file is never
# committed, never pushed and never packaged: `app/build.gradle.kts` reads it at build time and writes
# the generated configuration into the module's build directory, not into the APK.
/.env

# Generated at build time from the git-ignored `.env` above (see `generateAzureAppConfig` in
# app/build.gradle.kts). It is a *packaged* MSAL resource — public application identifiers only —
# but it is still generated, so it stays out of source control.
app/src/main/res/raw/msal_config_default.json
